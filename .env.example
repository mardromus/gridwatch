# Optional. Groq is preferred when both providers are configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Backward-compatible OpenAI provider. The deterministic brief works with no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Host port for docker compose.
PORT=8000
CORS_ORIGINS=http://localhost:8000

# Compose sets this to /data/gridwatch.db. Override only for non-container runs.
GRIDWATCH_DB_PATH=